# Copy to .env (never commit .env) and fill in.

# The domain the app is served on. Caddy gets an HTTPS certificate for it automatically
# (ports 80 and 443 must reach this machine). "localhost" uses a local certificate.
SITE_ADDRESS=localhost

# Signs login tokens. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
GPA_TRACKER_SECRET_KEY=

# Email for password-reset links. Without GPA_TRACKER_SMTP_HOST the link is written to the API log
# (docker compose logs api).
GPA_TRACKER_SMTP_HOST=
GPA_TRACKER_SMTP_PORT=587
GPA_TRACKER_SMTP_USER=
GPA_TRACKER_SMTP_PASSWORD=
GPA_TRACKER_MAIL_FROM=
